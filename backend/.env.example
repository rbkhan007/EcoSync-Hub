# Backend environment variables example
# Copy to .env and fill in real values before starting the server

# Backend
PORT=5000

# Frontend origins (comma-separated). Include scheme and port if needed.
# Example: http://localhost:5173,https://ecosync-hub-frontend.onrender.com
FRONTEND_URL=http://localhost:5173

# JWT secret used to sign tokens
JWT_SECRET=your_jwt_secret_here

# Database (either a full URL or individual parts below)
# DATABASE_URL=postgresql://user:pass@host:port/dbname
DB_HOST=localhost
DB_PORT=5432
DB_USER=ecosync_user
DB_PASSWORD=change_me
DB_NAME=ecosync_hub
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=ecosync_hub
PORT=5000
JWT_SECRET=
FRONTEND_URL=http://localhost:5173,https://ecosync-hub-frontend.onrender.com
