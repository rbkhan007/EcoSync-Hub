{
    "name": "ecosync-hub-fullstack",
    "version": "1.0.0",
    "description": "Fullstack EcoSync Hub application",
    "scripts": {
        "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
        "backend": "npm --prefix backend run dev",
        "frontend": "npm --prefix frontend run dev",
        "build": "npm --prefix frontend install && npm --prefix frontend run build",
        "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix"
    },
    "devDependencies": {
        "concurrently": "^9.2.1",
        "eslint": "^10.0.0",
        "eslint-plugin-react": "^7.37.5"
    },
    "dependencies": {
        "concurrently": "^9.2.1"
    }
}